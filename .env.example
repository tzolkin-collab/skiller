# Copie para .env na raiz do repositório. Os dois pacotes leem daqui
# (backend e frontend usam `env-cmd -f ../.env`).

# ---------- Obrigatórias ----------

# YouTube Data API v3 — metadados de playlist e vídeo
YOUTUBE_API_KEY=

# Google AI (Gemini) — extração e síntese
GEMINI_API_KEY=

# Postgres da aplicação
DATABASE_URL=postgresql://user:pass@host:5432/skiller

# Redis (BullMQ). O código lê estas três — não use REDIS_URL, ela é ignorada.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# URL do backend usada pelo frontend no browser.
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL pública do backend para receber webhooks e redirects OAuth (Slack, Notion, Stripe)
API_URL=http://localhost:3001

# ---------- Identidade (login) ----------
# Sem estas, o login por provedor some da tela e sobram senha e link magico.

# Google: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID
# Redirect URI autorizada: {API_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: Settings > Developer settings > OAuth Apps
# Authorization callback URL: {API_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Aceita `?userId=` como identidade. NAO e autenticacao — existe so para os
# scripts de teste e auditoria, e e ignorado quando NODE_ENV=production.
ALLOW_QUERY_USER=false

# ---------- E-mail transacional (Resend) ----------
# Sem a chave, os e-mails sao impressos no log do backend com o link inteiro,
# que e o suficiente para desenvolver cadastro e link magico.
RESEND_API_KEY=

# Precisa ser de um dominio verificado no Resend.
EMAIL_FROM=Skiller <nao-responda@skiller.local>

# ---------- Cobranca (Stripe) ----------
# Sem STRIPE_SECRET_KEY o backend sobe normalmente e /api/billing responde 503.
# Preencha para ligar a cobrança.

# Chave secreta. `sk_test_...` no desenvolvimento, `sk_live_...` em produção.
STRIPE_SECRET_KEY=

# Chave pública, usada pelo frontend. Não é segredo, mas é por ambiente.
STRIPE_PUBLISHABLE_KEY=

# Segredo do webhook, para verificar que o evento veio mesmo do Stripe.
# Em desenvolvimento sai do `stripe listen`:
#   stripe listen --forward-to localhost:3001/api/billing/webhook
# Em produção sai do painel, ao cadastrar o endpoint.
STRIPE_WEBHOOK_SECRET=

# Para onde o Stripe devolve o navegador depois do pagamento. É a URL que o
# usuário enxerga (o frontend), não a do backend.
APP_URL=http://localhost:3000

# Aponta o SDK para um Stripe falso, para desenvolver e testar a cobranca sem
# conta e sem chave real. Vazio em producao.
#   pnpm --filter backend run billing:mock
#   STRIPE_API_BASE=http://localhost:12111
STRIPE_API_BASE=

# Stripe Tax calculando imposto sozinho. Só ligue se estiver habilitado na
# conta — com `true` sem habilitar, toda criação de checkout falha.
STRIPE_AUTOMATIC_TAX=false

# ---------- Opcionais ----------

# Porta do backend (default 3001)
BACKEND_PORT=3001

# Jobs processados em paralelo pelo worker (default 4).
# Cada vídeo faz uma busca de transcrição e uma chamada de LLM, ambas de rede —
# em 1 uma playlist de 50 vídeos estoura a meta de 5 min. Baixe se bater rate limit.
WORKER_CONCURRENCY=4

# Grava a resposta crua do LLM em backend/fixtures/ (1 = liga, padrão desligado).
# Ligue antes de rodar uma geração que você quer depurar: com o arquivo salvo,
# iterar no prompt deixa de exigir nova chamada paga.
SKILLER_RECORD_LLM=0


# Origem permitida no CORS
FRONTEND_URL=http://localhost:3000

# Conexão de administrador, usada só por `backend/scripts/create-db.js`
# para criar o banco. Se ausente, o script tenta derivar de DATABASE_URL.
ADMIN_DATABASE_URL=

# OpenAI — hoje sem uso no pipeline (`services/openai.ts` é código morto).
# Preencha apenas se reativar aquele serviço.
OPENAI_API_KEY=
